{
  "name": "login-do-cidadao-ilc",
  "version": "1.4.0",
  "description": "Sistema de Dashboard - Índice de Lealdade Cívica (ILC) com Express e banco SQLite embutido",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev:server": "node server.js",
    "dev:client": "vite",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build": "vite build",
    "preview": "vite preview",
    "db:migrate-supabase": "node scripts/migrate-from-supabase.js",
    "build:mobile": "vite build --mode mobile",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npx cap sync",
    "cap:open": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "build:android": "npm run build:mobile && npx cap sync android",
    "build:ios": "npm run build:mobile && npx cap sync ios",
    "apk:release": "npm run build:android && cd android && gradlew assembleRelease",
    "aab:release": "npm run build:android && cd android && gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.2",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.18.1",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.460.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "vite": "^8.1.4"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "private": true
}
