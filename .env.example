# Example env file for ILC (do NOT commit secrets)
# Copy to .env and fill values before running in production

# Banco de dados SQLite embutido (arquivo ilc.db + backups diários)
# Em produção (Docker/EasyPanel) já vem como /usr/src/app/data — monte um volume nesse caminho.
DATA_DIR=./data
# Quantos backups diários manter em DATA_DIR/backups
BACKUP_KEEP=7
BACKUP_KEEP_MONTHLY=12
# Backup externo via GitHub Actions (mín. 32 caracteres; mesmo valor no secret do GitHub)
BACKUP_TOKEN=
# false = não cria os cidadãos de demonstração no primeiro boot (o admin é sempre criado)
SEED_DEMO=false

# Somente para a migração única dos dados antigos (scripts/migrate-from-supabase.js).
# Remova depois que a migração estiver concluída.
# SUPABASE_DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJ.supabase.co:5432/postgres

# Secrets (keep different values and store in secret manager)
JWT_SECRET=replace_with_a_strong_random_string
SESSION_SECRET=replace_with_a_strong_random_string

# Google OAuth (set in Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# WhatsApp (WAHA)
WAHA_BASE_URL=
WAHA_API_KEY=
WAHA_SESSION=default
WAHA_DEFAULT_CHAT_ID=

# App
PORT=3000
NODE_ENV=production

# Assistentes dos ministérios (IA do OpenRouter) — só no servidor, nunca no .env.mobile
OPENROUTER_API_KEY=
# Opcional: modelo(s) gratuitos separados por vírgula (o primeiro é o principal). Também dá para trocar no painel.
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Opcional: "true" desliga o agendador dos assistentes
ASSISTANTS_DISABLED=false
